# Linux -> Windows x64. Host and target Qt must have the same version.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(AURORA_QT_VERSION 6.11.1 CACHE STRING "Qt version used by both kits")
set(LLVM_MINGW_ROOT "$ENV{HOME}/Qt/llvm-mingw" CACHE PATH "llvm-mingw installation")
set(AURORA_QT_ROOT "$ENV{HOME}/Qt/${AURORA_QT_VERSION}" CACHE PATH "Directory containing both Qt kits")
set(CMAKE_C_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_AR "${LLVM_MINGW_ROOT}/bin/llvm-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${LLVM_MINGW_ROOT}/bin/llvm-ranlib" CACHE FILEPATH "")
set(QT_HOST_PATH "${AURORA_QT_ROOT}/gcc_64" CACHE PATH "Linux Qt tools")
set(CMAKE_PREFIX_PATH "${AURORA_QT_ROOT}/llvm-mingw_64" CACHE PATH "Windows Qt")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW_ROOT}/x86_64-w64-mingw32" "${CMAKE_PREFIX_PATH}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# Propagate user overrides to compiler try_compile subprojects.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AURORA_QT_VERSION LLVM_MINGW_ROOT AURORA_QT_ROOT QT_HOST_PATH CMAKE_PREFIX_PATH)
